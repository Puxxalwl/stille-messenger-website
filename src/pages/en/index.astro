---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Phone from '../../components/Phone.astro';
import { site } from '../../lib/config';
---
<Layout lang="en" title="Stille — conversations between you" description="A peer-to-peer messenger for Android. Choose a name, exchange an invite and start chatting — no phone number required." canonical="/en/">
  <Header />
  <main id="main" tabindex="-1">
    <section class="hero wrap" aria-labelledby="hero-heading">
      <div class="hero-copy"><h1 id="hero-heading">Stille</h1><p class="hero-tagline">Conversations between you</p><p class="hero-description">Choose a name and connect by invite. No phone number needed.</p><div class="hero-cta"><a class="button" href={site.apk}>Download APK <span aria-hidden="true">↓</span></a><a class="text-link" href="/en/guide/">Get started <span aria-hidden="true">→</span></a></div></div>
      <figure class="hero-preview"><div class="hero-art"><div class="hero-phone"><Phone lang="en"/></div></div><figcaption>A UI example. The conversation is fictional.</figcaption></figure>
    </section>
    <section class="start-section wrap" aria-labelledby="start-heading"><div class="section-heading"><h2 id="start-heading">From a name to a conversation</h2><p>No phone number needed.<br/>Connect through an invite.</p></div><div class="start-layout"><ol class="journey"><li><span class="step-number">1</span><div><h3>Choose a name</h3><p>Pick the name your contact will see. You can change your language and theme in settings.</p></div></li><li><span class="step-number">2</span><div><h3>Exchange an invite</h3><p>Create an invite in the app and share its link, or show the QR code nearby.</p></div></li><li><span class="step-number">3</span><div><h3>Start chatting</h3><p>Once the connection is confirmed, the person appears in your contacts.</p></div></li></ol><aside class="invite-aside"><img src="/assets/owl-invite.svg" width="180" height="168" loading="lazy" alt="Stille’s owl holding an invitation"/><p>Got an invite from a friend?</p><a href="/en/guide/">How to accept an invite →</a></aside></div></section>
    <section class="network-section wrap" aria-labelledby="network-heading"><div><p class="eyebrow">About connections</p><h2 id="network-heading">Peer to peer,<br/>device to device</h2></div><div class="network-copy"><p>Stille connects devices directly when a route exists between them. Invites without an address work on the same local network. Across different networks, a reachable address or relay may be needed.</p><p>The website does not connect devices or verify invites — good to know before installing.</p><div class="inline-links"><a href="/en/guide/">Connection troubleshooting →</a><a href="/en/about/">About the project and encryption →</a></div></div></section>
  </main><Footer />
</Layout>
