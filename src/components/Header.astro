---
const links = [{ href: '/guide/', label: 'Как начать' }, { href: '/about/', label: 'О проекте' }, { href: '/download/', label: 'Скачать' }];
const path = Astro.url.pathname;
---
<header class="site-header wrap">
  <a href="/" class="brand" aria-label="Stille — на главную"><img src="/assets/logo.webp" width="25" height="36" alt="" /><span>Stille</span></a>
  <nav class="desktop-nav" aria-label="Основная навигация">{links.map(link => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" aria-label="Переключить цветовую тему" hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg></button>
    <details class="mobile-menu"><summary>Меню <span aria-hidden="true">☰</span></summary><nav aria-label="Мобильная навигация">{links.map(link => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}</nav></details>
  </div>
</header>
<script>
  function setupHeader() {
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (!toggle || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true'; toggle.hidden = false;
    const media = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : media.matches;
    const label = () => toggle.setAttribute('aria-label', isDark() ? 'Включить светлую тему' : 'Включить тёмную тему');
    label(); media.addEventListener('change', label);
    toggle.addEventListener('click', () => {
      const theme = isDark() ? 'light' : 'dark'; document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('stille-theme', theme); } catch {} label();
    });
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    const escape = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    };
    document.addEventListener('keydown', escape);
    document.addEventListener('astro:before-swap', () => { media.removeEventListener('change', label); document.removeEventListener('keydown', escape); }, { once: true });
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>
