---
import { site } from '../lib/config';
---
<div id="invite-view" class="invite-card" data-deep-links={String(site.deepLinksEnabled)} hidden>
  <img id="invite-owl" src="/assets/owl-invite.svg" width="180" height="168" alt="Сова с конвертом" />
  <p class="eyebrow">ОДИН ЧЕЛОВЕК. ОДНО ПРИГЛАШЕНИЕ.</p>
  <h1 id="invite-title">Вас пригласили в Stille</h1>
  <p id="invite-description">Хороший разговор начинается с «привет». Откройте приглашение в приложении.</p>
  <p class="invite-status" id="invite-status" role="status" aria-live="polite"></p>
  <div id="manual-copy-wrap" hidden><label class="manual-label" for="manual-copy">Выделите и скопируйте приглашение вручную</label><textarea class="manual-copy" id="manual-copy" readonly spellcheck="false" autocomplete="off"></textarea></div>
  <div class="invite-instructions" id="invite-instructions"><strong>Как открыть приглашение</strong><ol><li>Нажмите «Открыть Stille».</li><li>Если приложение не открылось, установите или обновите Stille.</li><li>Затем вернитесь к этой странице и считайте QR встроенным сканером.</li></ol></div>
  <div class="invite-qr" id="invite-qr" hidden><canvas id="qr-canvas" aria-label="QR приглашения для сканера Stille" role="img"></canvas><p>Откройте сканер в Stille на телефоне.<br/>Не отправляйте этот QR посторонним.</p></div>
  <p class="invite-download">Ещё нет приложения? <a href={site.apk}>Скачать для Android · v{site.version} ↓</a></p>
  <p class="invite-privacy" id="invite-privacy">Сайт не сохраняет и не проверяет приглашение. При необходимости используйте QR с полным кодом <code>stille://i/…</code> во встроенном сканере Stille.</p>
  <a class="invite-general-link" href="/">Что такое Stille ↗</a>
</div>
<noscript><div class="invite-card"><img src="/assets/owl-invite.svg" width="160" height="150" alt="Сова с приглашением"/><h1>Приглашения в Stille</h1><p>Откройте эту HTTPS-ссылку в установленном приложении Stille. Если приложение не установлено, скачайте его, затем используйте QR с полным кодом <code>stille://i/…</code> во встроенном сканере.</p><p>Если в адресе нет кода, попросите друга прислать полную ссылку.</p><p><a href={site.apk}>Скачать Stille для Android</a> · <a href="/">На главную</a></p></div></noscript>
<script>
  import { parseInvitePath } from '../lib/invite.mjs';
  function setupInvite() {
  const view = document.querySelector<HTMLDivElement>('#invite-view');
  if (!view || view.dataset.ready) return;
  view.dataset.ready = 'true';
  const title = document.querySelector<HTMLElement>('#invite-title')!;
  const description = document.querySelector<HTMLElement>('#invite-description')!;
  const status = document.querySelector<HTMLElement>('#invite-status')!;
  const result = parseInvitePath(window.location.pathname);
  view.hidden = false;
  if (result.kind === 'valid' && result.uri) {
    const uri = result.uri;
    document.title = 'Вас пригласили в Stille';
    if (view.dataset.deepLinks === 'true') {
      document.querySelector<HTMLElement>('#invite-privacy')!.textContent = 'Если Stille установлено, Android автоматически передаст ссылку приложению. Если приложение не открылось, используйте QR с полным stille://-кодом во встроенном сканере.';
      // Android App Links open this HTTPS URL directly when assetlinks.json and
      // the installed release certificate are configured. The page remains a
      // useful fallback on desktop and on Android without the app.
      if (/Android/i.test(navigator.userAgent)) {
        window.setTimeout(() => {
          if (document.visibilityState === 'visible' && view.isConnected) {
            const intent = `intent://${window.location.host}${window.location.pathname}#Intent;scheme=https;package=com.stille.messenger;end`;
            window.location.href = intent;
          }
        }, 120);
      }
    }
    if (result.qrAllowed) {
      import('qrcode').then(async (QRCode) => {
        if (!view.isConnected) return;
        const canvas = view.querySelector<HTMLCanvasElement>('#qr-canvas')!;
        await QRCode.toCanvas(canvas, uri, { width: 320, margin: 4, errorCorrectionLevel: 'H', color: { dark: '#000000', light: '#ffffff' } });
        if (view.isConnected) view.querySelector<HTMLElement>('#invite-qr')!.hidden = false;
      }).catch(() => { status.textContent = 'QR не удалось показать. Откройте HTTPS-ссылку в приложении.'; });
    } else status.textContent = 'Приглашение слишком длинное для QR. Откройте HTTPS-ссылку в приложении.';
  } else {
    const help = result.kind === 'help';
    title.textContent = help ? 'Позовите своего человека' : result.kind === 'missing' ? 'Здесь пока тихо' : 'В ссылке что-то не так';
    document.title = help ? 'Приглашения в Stille' : result.kind === 'missing' ? 'Страница не найдена — Stille' : 'Некорректное приглашение — Stille';
    description.textContent = help ? 'Создайте одноразовое приглашение в приложении и отправьте его другу. Получили приглашение? Откройте полную ссылку с кодом.' : result.kind === 'missing' ? 'Похоже, такой страницы нет. Возможно, в адрес закралась опечатка. Вернёмся к разговорам?' : 'Код отсутствует, повреждён или имеет неподдерживаемый формат. Попросите отправителя скопировать полную ссылку заново.';
    if (!help) {
      const owl = document.querySelector<HTMLImageElement>('#invite-owl')!; owl.src = '/assets/owl-lost.svg'; owl.alt = 'Сова ищет потерянную страницу';
      document.querySelector<HTMLElement>('#invite-instructions')!.hidden = true;
      document.querySelector<HTMLElement>('#invite-privacy')!.hidden = true;
      document.querySelector<HTMLElement>('.invite-card .eyebrow')!.textContent = result.kind === 'missing' ? '404 / НЕ ТУДА СВЕРНУЛИ' : 'ПРИГЛАШЕНИЕ НЕ РАСПОЗНАНО';
    }
  }
  }
  document.addEventListener('astro:page-load', setupInvite);
</script>
